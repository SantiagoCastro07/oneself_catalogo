---
import Base from '../../layouts/Base.astro';
import TarjetaCombo from '../../components/TarjetaCombo.astro';
import ChipsCatalogo from '../../components/ChipsCatalogo.astro';
import { url } from '../../lib/url';
import { combosActivos } from '../../lib/combos';

const combos = await combosActivos();
const descripcion = 'Combos de decants originales: varios perfumes del mismo tamaño a un mejor precio que por separado. Envíos a toda Colombia.';
---
<Base titulo="Combos de decants" descripcion={descripcion}>
  <section class="wrap combos">
    <nav class="migas" aria-label="Ruta">
      <a href={url()}>Inicio</a><span aria-hidden="true">/</span>
      <span aria-current="page">Combos</span>
    </nav>
    <header class="combos__cab">
      <h1 class="display combos__tit">Combos</h1>
      <p class="muted combos__intro">Varios decants juntos, a mejor precio que pedirlos por separado. Ideal para comparar y quedarte con tu favorito.</p>
    </header>

    <ChipsCatalogo activo="combos" />

    {combos.length > 0 ? (
      <div class="combos__rejilla">
        {combos.map((c, i) => <TarjetaCombo c={c} prioridad={i === 0} />)}
      </div>
    ) : (
      <p class="combos__vacio muted">Pronto tendremos combos nuevos. Mientras tanto, <a href={url('catalogo')}>mira el catálogo</a>.</p>
    )}
  </section>
</Base>

<style>
  .combos { padding-top: var(--s4); padding-bottom: var(--s8); }
  .migas { display: flex; flex-wrap: wrap; gap: var(--s2); font-size: 13px; color: var(--ink-2); margin-bottom: var(--s4); }
  .migas a:hover { color: var(--ink); text-decoration: underline; }
  .migas [aria-current] { color: var(--ink); }
  .combos__tit { font-size: 32px; }
  .combos__intro { margin-top: var(--s2); max-width: 56ch; }
  .combos__rejilla { margin-top: var(--s5); display: grid; gap: var(--s6) var(--s4); grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 768px) { .combos__rejilla { grid-template-columns: repeat(2, minmax(0, 1fr)); } .combos__tit { font-size: 44px; } }
  @media (min-width: 1100px) { .combos__rejilla { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .combos__vacio a { text-decoration: underline; text-underline-offset: 3px; }
</style>
