---
// Home provisional: la definitiva llega en la fase 4.
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
import tienda from '../data/tienda.json';
---
<Base titulo="OneSelf" noindex>
  <section class="wrap prov">
    <p class="eyebrow">Vista previa · fase 2</p>
    <h1 class="display">{tienda.eslogan}</h1>
    <p class="muted">Perfumes originales en decants de 5 y 10 ml. La página de inicio definitiva llega en la fase 4.</p>
    <a class="btn" href={url('catalogo')}>Ver catálogo</a>
  </section>
</Base>
<style>
  .prov { padding: var(--s8) var(--gutter); display: grid; gap: var(--s4); justify-items: start; max-width: 720px; }
  h1 { font-size: 40px; line-height: 1.05; }
</style>
