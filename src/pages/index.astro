---
import Base from '../layouts/Base.astro';
import Tarjeta from '../components/Tarjeta.astro';
import Icono from '../components/Icono.astro';
import { Image } from 'astro:assets';
import imagenHero from '../assets/hero.png';
import { url } from '../lib/url';
import { datosNavegacion, agotado, pedible, formatoPrecio, type Perfume } from '../lib/catalogo';
import { CATEGORIAS } from '../lib/categorias';
import { TAMANO_TEXTO } from '../lib/whatsapp';
import tienda from '../data/tienda.json';

const { perfumes, marcas, marcasTop } = await datosNavegacion();
const disponibles = perfumes.filter((p) => !agotado(p));
const nuevos = disponibles.filter((p) => p.data.etiquetas.includes('nuevo'));
const destacados = disponibles.filter((p) => p.data.etiquetas.includes('destacado'));
// Sin destacados marcados todavía: mostrar una selección variada (uno por marca, en orden recomendado)
const vistaMarca = new Set<string>();
const seleccion = destacados.length >= 4 ? destacados.slice(0, 8) : disponibles.filter((p) => !nuevos.includes(p) && !vistaMarca.has(p.data.marca.id) && vistaMarca.add(p.data.marca.id)).slice(0, 8);
const tituloSeleccion = destacados.length >= 4 ? 'Favoritos de OneSelf' : 'Para empezar a descubrir';

// Categorías con foto representativa
const usadas = new Set<Perfume>([...nuevos]);
const cats = ['hombre', 'mujer', 'unisex', 'arabes'].map((s) => CATEGORIAS.find((c) => c.slug === s)!).map((c) => {
  const lista = disponibles.filter(c.filtro);
  const foto = lista.find((p) => !usadas.has(p)) || lista[0];
  if (foto) usadas.add(foto);
  return { c, n: perfumes.filter(c.filtro).length, foto };
}).filter((x) => x.foto);

// Tamaños: precio "desde" real por tamaño
const rend = tienda.rendimiento as Record<string, number | string>;
const tamanos = (['3ml', '5ml', '10ml', 'frasco'] as const).map((t) => {
  const precios = disponibles.flatMap((p) => p.data.variantes.filter((v) => v.tamano === t && pedible(v)).map((v) => v.precio));
  return { t, desde: precios.length ? Math.min(...precios) : 0, n: precios.length };
}).filter((x) => x.n > 0);
const DESC_TAMANO: Record<string, string> = {
  '3ml': 'Para conocer un perfume de diseñador o nicho.',
  '5ml': 'Para probarlo varios días, en tu piel y tu rutina.',
  '10ml': 'Para usarlo seguido o llevarlo contigo.',
  frasco: 'Para cuando ya sabes que es el tuyo. Envío incluido.',
};
---
<Base titulo="OneSelf" descripcion={tienda.descripcion}>
  <section class="hero">
    <div class="wrap hero__in">
      <div class="hero__txt">
        <p class="eyebrow">Perfumes originales en decants</p>
        <h1 class="display hero__tit">{tienda.eslogan}</h1>
        <p class="hero__sub">Prueba tu próximo perfume en 5 o 10 ml antes de comprar el frasco. Envíos a toda Colombia.</p>
        <div class="hero__cta">
          <a class="btn" href={url('catalogo')}>Ver catálogo</a>
          <a class="btn btn--sec" href={url('como-funciona')}>Cómo funciona</a>
        </div>
      </div>
      <div class="hero__foto">
        <Image src={imagenHero} alt="Frascos originales de perfume y, delante, decants OneSelf de 5 y 10 ml" widths={[360, 480, 560]} sizes="(min-width: 1024px) 560px, 100vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="pasos" aria-label="Cómo pedir">
    <ol class="wrap pasos__in">
      <li><span class="pasos__n">1</span><span><strong>Elige tu perfume</strong><br class="solo-movil" /> entre {perfumes.length} fragancias</span></li>
      <li><span class="pasos__n">2</span><span><strong>Elige el tamaño</strong><br class="solo-movil" /> 5 ml, 10 ml o frasco</span></li>
      <li><span class="pasos__n">3</span><span><strong>Pide por WhatsApp</strong><br class="solo-movil" /> y te lo enviamos</span></li>
    </ol>
  </section>

  <section class="wrap seccion">
    <div class="seccion__cab"><h2 class="display">Explora</h2></div>
    <div class="cats">
      {cats.map(({ c, n, foto }) => (
        <a class="cat-t" href={url(`catalogo/${c.slug}`)}>
          <div class="cat-t__foto"><Image src={foto!.data.imagenes[0]} alt="" widths={[200, 320, 440]} sizes="(min-width: 1024px) 270px, 45vw" loading="lazy" /></div>
          <p class="cat-t__nombre">{c.corto}</p>
          <p class="cat-t__n muted">{n} perfumes</p>
        </a>
      ))}
    </div>
  </section>

  {nuevos.length > 0 && (
    <section class="wrap seccion">
      <div class="seccion__cab"><h2 class="display">Lo nuevo</h2><a class="seccion__mas" href={url('catalogo/nuevos')}>Ver todo <Icono nombre="flecha" clase="icon icon--xs" /></a></div>
      <div class="carril">{nuevos.map((p) => <div class="carril__item"><Tarjeta p={p} marca={marcas[p.data.marca.id]} /></div>)}</div>
    </section>
  )}

  <section class="tamanos-home">
    <div class="wrap">
      <div class="seccion__cab"><h2 class="display">Elige cuánto quieres probar</h2></div>
      <p class="muted tamanos-home__intro">{tienda.textoDecant}</p>
      <div class="tam-grid">
        {tamanos.map((x) => (
          <div class="tam-c">
            <p class="tam-c__ml display">{x.t === 'frasco' ? 'Frasco' : TAMANO_TEXTO[x.t]}</p>
            <p class="tam-c__desc">{DESC_TAMANO[x.t]}</p>
            {typeof rend[x.t] === 'number' && <p class="tam-c__rinde muted">≈ {rend[x.t]} atomizaciones</p>}
            <p class="tam-c__desde">Desde {formatoPrecio(x.desde)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap seccion">
    <div class="seccion__cab"><h2 class="display">{tituloSeleccion}</h2><a class="seccion__mas" href={url('catalogo')}>Ver catálogo <Icono nombre="flecha" clase="icon icon--xs" /></a></div>
    <div class="rejilla-home">{seleccion.map((p) => <Tarjeta p={p} marca={marcas[p.data.marca.id]} />)}</div>
  </section>

  <section class="wrap seccion">
    <div class="seccion__cab"><h2 class="display">Marcas</h2><a class="seccion__mas" href={url('marcas')}>Ver todas <Icono nombre="flecha" clase="icon icon--xs" /></a></div>
    <ul class="marcas-fila">
      {marcasTop.map((m) => <li><a class="chip" href={url(`marcas/${m.slug}`)}>{m.nombre}</a></li>)}
    </ul>
  </section>

  <section class="wrap seccion porque">
    <h2 class="display">Por qué OneSelf</h2>
    <ul class="porque__lista">
      <li><strong>Perfumes originales</strong><span class="muted">Los decants salen del frasco original de cada marca.</span></li>
      <li><strong>Prueba antes de comprar</strong><span class="muted">Conoce cómo se comporta un perfume en tu piel antes de invertir en el frasco.</span></li>
      <li><strong>Pedido fácil</strong><span class="muted">Eliges en la página, confirmas por WhatsApp y te lo enviamos a toda Colombia.</span></li>
    </ul>
    <a class="porque__link" href={url('nosotros')}>Conoce OneSelf</a>
  </section>
</Base>

<style>
  .hero { overflow: hidden; }
  .hero__in { display: grid; gap: var(--s4); padding-top: var(--s5); padding-bottom: var(--s5); }
  .hero__tit { font-size: clamp(32px, 8.4vw, 60px); line-height: 1.04; margin-top: var(--s3); max-width: 16ch; }
  .hero__sub { margin-top: var(--s4); font-size: 16.5px; color: var(--ink-2); max-width: 40ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s5); }
  .hero__foto { display: grid; place-items: center; }
  .hero__foto img { display: block; width: 100%; max-width: 340px; height: auto; object-fit: contain; }

  .pasos { border-bottom: 1px solid var(--line); }
  .pasos__in { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s3); padding-top: var(--s4); padding-bottom: var(--s4); margin: 0 auto; list-style: none; font-size: 13px; line-height: 1.35; }
  .pasos li { display: flex; gap: var(--s2); align-items: flex-start; }
  .pasos__n { flex: none; width: 22px; height: 22px; border-radius: 50%; border: 1px solid var(--ink); display: grid; place-items: center; font-size: 12px; }
  .pasos strong { font-weight: 500; }

  .seccion { margin-top: var(--s7); }
  .seccion__cab { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s3); margin-bottom: var(--s4); }
  .seccion__cab h2, .porque h2 { font-size: 26px; }
  .seccion__mas { display: inline-flex; align-items: center; gap: 4px; font-size: 14px; white-space: nowrap; }
  .seccion__mas:hover { text-decoration: underline; text-underline-offset: 3px; }
  :global(.icon--xs) { width: 16px; height: 16px; }

  .cats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s3); }
  .cat-t__foto { aspect-ratio: 4 / 3; background: var(--bg-photo); display: grid; place-items: center; overflow: hidden; }
  .cat-t__foto img { width: 80%; height: 80%; object-fit: contain; transition: transform 300ms ease; }
  .cat-t:hover .cat-t__foto img { transform: scale(1.04); }
  .cat-t__nombre { margin-top: var(--s2); font-weight: 500; font-size: 16px; }
  .cat-t__n { font-size: 13px; }

  .carril { display: grid; grid-auto-flow: column; grid-auto-columns: 44%; gap: var(--s3); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter); scroll-padding: 0 var(--gutter); }
  .carril::-webkit-scrollbar { display: none; }
  .carril__item { scroll-snap-align: start; min-width: 0; }

  .tamanos-home { margin-top: var(--s7); background: var(--ink); color: var(--on-ink); padding: var(--s7) 0; }
  .tamanos-home .muted { color: #A9B0BB; }
  .tamanos-home__intro { max-width: 60ch; margin-top: calc(var(--s2) * -1); }
  .tam-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s3); margin-top: var(--s5); }
  .tam-c { border: 1px solid rgba(246,245,242,.18); border-radius: var(--radius); padding: var(--s4); display: grid; gap: var(--s1); align-content: start; }
  .tam-c__ml { font-size: 28px; line-height: 1; }
  .tam-c__desc { font-size: 14px; margin-top: var(--s2); }
  .tam-c__rinde { font-size: 13px; }
  .tam-c__desde { margin-top: var(--s2); font-weight: 500; }

  .rejilla-home { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s6) var(--s3); }
  .marcas-fila { display: flex; flex-wrap: wrap; gap: var(--s2); }

  .porque { border-top: 1px solid var(--line); padding-top: var(--s7); }
  .porque__lista { display: grid; gap: var(--s5); margin-top: var(--s5); }
  .porque__lista li { display: grid; gap: var(--s1); }
  .porque__lista strong { font-weight: 500; font-size: 17px; }
  .porque__link { display: inline-block; margin-top: var(--s5); text-decoration: underline; text-underline-offset: 3px; }

  .solo-movil { display: inline; }
  @media (min-width: 640px) {
    .solo-movil { display: none; }
    .pasos__in { font-size: 14.5px; }
    .carril { grid-auto-columns: 30%; }
  }
  @media (min-width: 1024px) {
    .hero__in { grid-template-columns: 1fr 1fr; align-items: center; padding-top: var(--s8); padding-bottom: var(--s8); }
    .hero__tit { max-width: 12ch; }
    .hero__foto img { max-width: 440px; }
    .pasos__in { justify-content: center; }
    .seccion { margin-top: var(--s8); }
    .seccion__cab h2, .porque h2 { font-size: 34px; }
    .cats { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s5); }
    .carril { grid-auto-flow: row; grid-template-columns: repeat(4, minmax(0, 1fr)); overflow: visible; margin: 0; padding: 0; gap: var(--s5); }
    .tamanos-home { margin-top: var(--s8); padding: var(--s8) 0; }
    .tam-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s5); }
    .rejilla-home { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s7) var(--s5); }
    .porque__lista { grid-template-columns: repeat(3, 1fr); gap: var(--s6); }
  }
</style>
