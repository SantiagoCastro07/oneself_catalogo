---
// Tarjeta de un combo. A propósito sin `data-tarjeta`: esa marca es la que usa el catálogo
// (filtros, orden y sincronización con el Manager) y los combos no son perfumes sueltos.
import { Image } from 'astro:assets';
import { url } from '../lib/url';
import { ETIQUETA_TAMANO } from '../lib/catalogo';
import { type ComboResuelto, precioDesdeCombo, ahorroMaximo, formatoPrecio } from '../lib/combos';

interface Props { c: ComboResuelto; prioridad?: boolean }
const { c, prioridad = false } = Astro.props;
const desde = precioDesdeCombo(c);
const ahorro = ahorroMaximo(c);
const n = c.perfumes.length;
const tamanos = c.opciones.filter((o) => o.estado !== 'agotado').map((o) => `${n} × ${ETIQUETA_TAMANO[o.tamano]}`);
---
<a class:list={['tcombo', { 'is-agotado': c.agotado }]} href={url(`combos/${c.combo.id}`)}>
  <div class="tcombo__foto">
    <Image
      src={c.combo.data.imagen}
      alt={`${c.combo.data.nombre}: ${c.perfumes.map((p) => p.data.nombre).join(', ')}`}
      widths={[400, 600, 800, 1200]}
      sizes="(min-width: 1024px) 560px, 100vw"
      loading={prioridad ? 'eager' : 'lazy'}
      fetchpriority={prioridad ? 'high' : 'auto'}
      decoding="async"
    />
    {c.agotado ? <span class="sello sello--agotado">Agotado</span> : ahorro > 0 && <span class="sello">Ahorras {formatoPrecio(ahorro)}</span>}
  </div>
  <p class="tcombo__marca">{c.marca || 'Combo'}</p>
  <h3 class="tcombo__nombre">{c.combo.data.nombre}</h3>
  <p class="tcombo__precio">{c.agotado ? formatoPrecio(desde) : <>Desde {formatoPrecio(desde)}</>}</p>
  {!c.agotado && <p class="tcombo__tam">{tamanos.join(' · ')}</p>}
</a>
<style>
  .tcombo { display: block; min-width: 0; }
  .tcombo__foto { position: relative; aspect-ratio: 4 / 3; background: var(--bg-photo); overflow: hidden; }
  .tcombo__foto img { width: 100%; height: 100%; object-fit: contain; padding: 4%; transition: transform 300ms ease; }
  @media (hover: hover) { .tcombo:hover .tcombo__foto img { transform: scale(1.03); } .tcombo:hover .tcombo__nombre { text-decoration: underline; text-underline-offset: 3px; } }
  .sello { position: absolute; top: 8px; left: 8px; background: var(--bg); color: var(--ink); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; padding: 3px 7px; border-radius: 2px; }
  .sello--agotado { background: var(--ink); color: var(--on-ink); }
  .is-agotado .tcombo__foto img { opacity: .5; }
  .tcombo__marca { margin-top: var(--s3); font-size: 11.5px; letter-spacing: .07em; text-transform: uppercase; color: var(--ink-2); }
  .tcombo__nombre { margin-top: 2px; font-size: 15px; font-weight: 500; line-height: 1.3; }
  .tcombo__precio { margin-top: var(--s1); font-size: 15px; }
  .is-agotado .tcombo__precio { color: var(--ink-3); text-decoration: line-through; }
  .tcombo__tam { margin-top: 2px; font-size: 12.5px; color: var(--ink-2); }
</style>
