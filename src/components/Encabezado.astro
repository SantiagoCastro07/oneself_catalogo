---
import Icono from './Icono.astro';
import Bolsa from './Bolsa.astro';
import { url, whatsappUrl } from '../lib/url';
import { CATEGORIAS, MINIMO_EN_MENU } from '../lib/categorias';
import { datosNavegacion } from '../lib/catalogo';
import tienda from '../data/tienda.json';

const { perfumes, marcasTop } = await datosNavegacion();
const visibles = CATEGORIAS.filter((c) => perfumes.filter(c.filtro).length >= MINIMO_EN_MENU);
const genero = visibles.filter((c) => c.grupo === 'genero');
const tipo = visibles.filter((c) => c.grupo === 'tipo');
const hayNuevos = visibles.some((c) => c.slug === 'nuevos');
const actual = Astro.url.pathname;
const esActual = (href: string) => actual === href || (href !== url() && actual.startsWith(href) && href !== url('catalogo'));
---
<div class="anuncio">{tienda.anuncio}</div>
<header class="cab">
  <div class="wrap cab__in">
    <button class="icon-btn cab__menu" type="button" aria-label="Abrir menú" aria-controls="menu" aria-expanded="false" data-abrir="menu">
      <Icono nombre="menu" />
    </button>
    <a class="cab__logo display" href={url()} aria-label="OneSelf, inicio">OneSelf</a>
    <nav class="cab__nav" aria-label="Principal">
      <a href={url('catalogo')} aria-current={actual === url('catalogo') ? 'page' : undefined}>Catálogo</a>
      {genero.map((c) => <a href={url(`catalogo/${c.slug}`)} aria-current={esActual(url(`catalogo/${c.slug}`)) ? 'page' : undefined}>{c.corto}</a>)}
      {tipo.map((c) => <a href={url(`catalogo/${c.slug}`)} aria-current={esActual(url(`catalogo/${c.slug}`)) ? 'page' : undefined}>{c.corto}</a>)}
      {hayNuevos && <a href={url('catalogo/nuevos')} aria-current={esActual(url('catalogo/nuevos')) ? 'page' : undefined}>Nuevos</a>}
      <a href={url('marcas')} aria-current={actual.startsWith(url('marcas')) ? 'page' : undefined}>Marcas</a>
    </nav>
    <div class="cab__acc">
      <button class="icon-btn" type="button" aria-label="Buscar" aria-controls="buscador" data-abrir="buscador"><Icono nombre="buscar" /></button>
      <button class="icon-btn" type="button" aria-label="Abrir bolsa" aria-controls="bolsa" data-abrir-bolsa><Icono nombre="bolsa" /><span class="contador" data-bolsa-contador hidden></span></button>
    </div>
  </div>
</header>

<div class="velo" data-velo hidden></div>
<Bolsa />

<aside id="menu" class="panel panel--izq" aria-label="Menú" hidden>
  <div class="panel__cab">
    <span class="display panel__logo">OneSelf</span>
    <button class="icon-btn" type="button" aria-label="Cerrar menú" data-cerrar><Icono nombre="cerrar" /></button>
  </div>
  <nav class="panel__cuerpo">
    <p class="eyebrow menu__tit">Catálogo</p>
    <ul class="menu__lista">
      <li><a href={url('catalogo')}>Todos los perfumes</a></li>
      {genero.map((c) => <li><a href={url(`catalogo/${c.slug}`)}>{c.corto}</a></li>)}
    </ul>
    {tipo.length > 0 && (<>
      <p class="eyebrow menu__tit">Tipo</p>
      <ul class="menu__lista">{tipo.map((c) => <li><a href={url(`catalogo/${c.slug}`)}>{c.corto}</a></li>)}</ul>
    </>)}
    {hayNuevos && <ul class="menu__lista"><li><a href={url('catalogo/nuevos')}>Lo nuevo</a></li></ul>}
    <p class="eyebrow menu__tit">Marcas</p>
    <ul class="menu__lista">
      {marcasTop.slice(0, 6).map((m) => <li><a href={url(`marcas/${m.slug}`)}>{m.nombre}</a></li>)}
      <li><a href={url('marcas')} class="muted">Ver todas las marcas</a></li>
    </ul>
  </nav>
  <div class="panel__pie">
    <a class="btn btn--block" href={whatsappUrl(tienda.whatsapp, 'Hola OneSelf, tengo una pregunta')} target="_blank" rel="noopener"><Icono nombre="whatsapp" /> Escríbenos por WhatsApp</a>
    <div class="menu__redes">
      <a href={tienda.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icono nombre="instagram" /></a>
      <a href={tienda.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><Icono nombre="tiktok" /></a>
    </div>
  </div>
</aside>

<div id="buscador" class="buscador" role="dialog" aria-label="Buscar perfumes" hidden>
  <form class="wrap buscador__in" action={url('catalogo')} method="get" role="search">
    <Icono nombre="buscar" />
    <input type="search" name="q" placeholder="Busca un perfume o una marca" aria-label="Buscar" autocomplete="off" enterkeyhint="search" />
    <button class="icon-btn" type="button" aria-label="Cerrar búsqueda" data-cerrar><Icono nombre="cerrar" /></button>
  </form>
</div>

<style>
  .anuncio { background: var(--ink); color: var(--on-ink); font-size: 12.5px; letter-spacing: .03em; text-align: center; padding: 7px var(--gutter); }
  .cab { position: sticky; top: 0; z-index: 30; background: rgba(246,245,242,.96); border-bottom: 1px solid var(--line); }
  @supports (backdrop-filter: blur(1px)) { .cab { background: rgba(246,245,242,.9); backdrop-filter: saturate(1.2) blur(8px); } }
  .cab__in { height: var(--header-h); display: grid; grid-template-columns: 88px 1fr 88px; align-items: center; }
  .cab__logo { justify-self: center; font-size: 26px; line-height: 1; }
  .cab__nav { display: none; }
  .cab__acc { justify-self: end; display: flex; }
  @media (min-width: 1024px) {
    .cab__in { grid-template-columns: auto 1fr auto; gap: var(--s6); }
    .cab__menu { display: none; }
    .cab__logo { justify-self: start; font-size: 28px; }
    .cab__nav { display: flex; gap: var(--s5); justify-content: center; font-size: 14.5px; }
    .cab__nav a { padding: 6px 0; border-bottom: 1px solid transparent; transition: border-color var(--t); }
    .cab__nav a:hover, .cab__nav a[aria-current="page"] { border-color: var(--ink); }
  }

  .velo { position: fixed; inset: 0; background: rgba(11,18,32,.4); z-index: 40; }
  .panel { position: fixed; top: 0; bottom: 0; z-index: 50; width: min(86vw, 360px); background: var(--bg); display: flex; flex-direction: column; box-shadow: 0 0 0 1px var(--line); }
  .panel--izq { left: 0; }
  .panel__cab { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); padding: 0 var(--s2) 0 var(--gutter); border-bottom: 1px solid var(--line); }
  .panel__logo { font-size: 24px; }
  .panel__cuerpo { flex: 1; overflow-y: auto; padding: var(--s3) var(--gutter) var(--s5); }
  .menu__tit { margin: var(--s5) 0 var(--s2); }
  .menu__lista a { display: block; padding: 10px 0; font-size: 17px; border-bottom: 1px solid var(--line); }
  .panel__pie { padding: var(--gutter); border-top: 1px solid var(--line); display: grid; gap: var(--s3); }
  .menu__redes { display: flex; gap: var(--s2); justify-content: center; }
  .menu__redes a { display: grid; place-items: center; width: 44px; height: 44px; }

  .buscador { position: fixed; top: 0; left: 0; right: 0; z-index: 50; background: var(--bg); border-bottom: 1px solid var(--line); }
  .buscador__in { height: var(--header-h); display: flex; align-items: center; gap: var(--s3); }
  .buscador input { flex: 1; min-width: 0; height: 44px; border: 0; background: transparent; font-size: 17px; outline: none; }
</style>

<script>
  // Menú lateral y buscador: abrir, cerrar con Esc / velo / botón, bloquear scroll.
  const velo = document.querySelector<HTMLElement>('[data-velo]')!;
  let abierto: HTMLElement | null = null;
  let origen: HTMLElement | null = null;
  function abrir(id: string, boton: HTMLElement) {
    const el = document.getElementById(id);
    if (!el) return;
    cerrar();
    el.hidden = false; velo.hidden = false; abierto = el; origen = boton;
    boton.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    (el.querySelector('input, a, button') as HTMLElement | null)?.focus();
  }
  function cerrar() {
    if (!abierto) return;
    abierto.hidden = true; velo.hidden = true;
    origen?.setAttribute('aria-expanded', 'false'); origen?.focus();
    document.body.style.overflow = '';
    abierto = null;
  }
  document.querySelectorAll<HTMLElement>('[data-abrir]').forEach((b) => b.addEventListener('click', () => abrir(b.dataset.abrir!, b)));
  document.querySelectorAll('[data-cerrar]').forEach((b) => b.addEventListener('click', cerrar));
  velo.addEventListener('click', cerrar);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrar(); });
</script>
